# Personal Website Environment Variables

# Database Configuration
DB_PASSWORD=your-secure-database-password-change-in-production

# JWT Secrets (generate strong random values for production)
JWT_SECRET=your-shared-jwt-secret-key-change-in-production-min-32-characters
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production-min-32-characters
TRANSFER_TOKEN_SALT=your-transfer-token-salt-change-in-production-min-32-characters
API_TOKEN_SALT=your-api-token-salt-change-in-production-min-32-characters
APP_KEYS=your-app-keys-change-in-production-min-32-characters

# Strapi Admin Configuration
STRAPI_ADMIN_CLIENT_PREVIEW_SECRET=your-preview-secret-change-in-production

# Storage Configuration
STORAGE_PROVIDER=local  # Options: local, s3, cloudflare_r2

# AWS S3 Configuration (if using S3)
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Cloudflare R2 Configuration (if using R2)
CLOUDFLARE_R2_BUCKET=your-r2-bucket-name
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key

# Email Configuration (for contact forms, newsletters)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# Domain Configuration
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
API_URL=https://yourdomain.com/api
STRAPI_URL=https://yourdomain.com/cms