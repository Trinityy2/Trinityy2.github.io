FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY . .

# Build admin panel
RUN npm run build

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S strapi -u 1001
RUN chown -R strapi:nodejs /app
USER strapi

# Expose port
EXPOSE 1337

# Start production server
CMD ["npm", "run", "start"]